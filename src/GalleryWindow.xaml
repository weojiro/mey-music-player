<Window x:Class="TaskbarPlayerProto.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1F1F1F"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="#FFFFFF"
        Height="810"
        ResizeMode="CanMinimize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Width="1180"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </Window.Resources>

    <Grid>
        <!-- "are you sure" before the user name is taken for good -->
        <Grid Background="#99000000" Panel.ZIndex="20" Visibility="Collapsed" x:Name="ConfirmLayer">
            <Border Background="{StaticResource Card}" CornerRadius="12" HorizontalAlignment="Center" MaxWidth="440" Padding="22" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock FontSize="14" TextWrapping="Wrap" x:Name="ConfirmText"/>
                    <StackPanel HorizontalAlignment="Right" Margin="0,18,0,0" Orientation="Horizontal">
                        <Button Margin="0,0,8,0" Style="{StaticResource Btn}" x:Name="ConfirmCancel"/>
                        <Button Background="#E6E6E6" FontWeight="SemiBold" Foreground="#1D1D1F" Style="{StaticResource Btn}" x:Name="ConfirmYes"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- first opening: the user name and the rules -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" x:Name="SetupPanel">
            <StackPanel HorizontalAlignment="Center" Margin="0,30,0,24" Width="560">
                <Border ClipToBounds="True" CornerRadius="13" Height="52" HorizontalAlignment="Center" Width="52" x:Name="WelcomeLogo"/>
                <TextBlock FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" x:Name="WelcomeTitle"/>
                <TextBlock Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,6,0,0" x:Name="WelcomeSub"/>
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Dim}" Margin="0,18,0,6" x:Name="ChooseNameText"/>
                <TextBox FontSize="15" MaxLength="20" Style="{StaticResource Field}" x:Name="UserNameBox"/>
                <TextBlock FontSize="12" Foreground="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap" x:Name="NameHintText"/>
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#F2A08A" Margin="0,4,0,0" TextWrapping="Wrap" x:Name="NameWarningText"/>
                <TextBlock FontSize="12" Foreground="#FF9A9A" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" x:Name="SetupMessage"/>
                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                    <CheckBox IsEnabled="False" Style="{StaticResource Square}" VerticalAlignment="Center" x:Name="AcceptBox"/>
                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" x:Name="RulesLink">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock FontSize="12" Foreground="#F2A08A" TextDecorations="Underline" x:Name="RulesLinkText"/>
                    </Button>
                    <TextBlock FontSize="12" Foreground="#DDDDDD" Margin="4,0,0,0" VerticalAlignment="Center" x:Name="AcceptTail"/>
                </StackPanel>
                <TextBlock FontSize="12" Foreground="{StaticResource Dim}" Margin="0,8,0,0" x:Name="OpenHint"/>
                <Border Background="#181818" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="10" Margin="0,12,0,0" Padding="16,14" Visibility="Collapsed" x:Name="RulesCard">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" x:Name="RulesTitle"/>
                        <TextBlock LineHeight="20" TextWrapping="Wrap" x:Name="RulesText"/>
                        <Button Background="#E6E6E6" Foreground="#1D1D1F" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource Btn}" x:Name="RulesClose"/>
                    </StackPanel>
                </Border>
                <Button Background="#E6E6E6" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F" IsEnabled="False" Margin="0,14,0,0" MinHeight="42" Style="{StaticResource Btn}" x:Name="CreateButton"/>
            </StackPanel>
        </ScrollViewer>

        <!-- publishing: what can be published on the left, what was published on the right -->
        <Grid Margin="22,16,22,12" Visibility="Collapsed" x:Name="PublishPage">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="42"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" x:Name="PageTitle"/>
                <TextBlock Foreground="{StaticResource Dim}" Margin="0,3,0,0" x:Name="PageSigned"/>
            </StackPanel>
            <Button Grid.Row="1" HorizontalAlignment="Left" Margin="0,14,0,0" Style="{StaticResource Btn}" x:Name="BackButton">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="12" Margin="0,0,7,0" Text="&#xE72B;" VerticalAlignment="Center" x:Name="BackIcon"/>
                    <TextBlock VerticalAlignment="Center" x:Name="BackText"/>
                </StackPanel>
            </Button>
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="470"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,6" Style="{StaticResource Section}" x:Name="PublishTitle"/>
                <StackPanel Grid.Row="1" x:Name="PublishList"/>
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center" x:Name="PublishPager"/>
                <TextBlock Grid.Column="2" Margin="0,0,0,6" Style="{StaticResource Section}" x:Name="MineTitle"/>
                <StackPanel Grid.Column="2" Grid.Row="1" x:Name="MineList"/>
                <StackPanel Grid.Column="2" Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center" x:Name="MinePager"/>
            </Grid>
            <TextBlock Foreground="{StaticResource Dim}" Grid.Row="3" HorizontalAlignment="Left" MaxWidth="500" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" x:Name="PublishMessage"/>
            <Border Background="#E4572E" CornerRadius="19" Grid.Row="3" HorizontalAlignment="Center" Padding="16,9" VerticalAlignment="Center" Visibility="Collapsed" x:Name="PublishToast">
                <TextBlock FontWeight="SemiBold" Foreground="White" x:Name="PublishToastText"/>
            </Border>
        </Grid>

        <!-- the gallery -->
        <Grid Margin="22,16,22,12" Visibility="Collapsed" x:Name="MainPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="42"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" x:Name="TitleText"/>
                <TextBlock Foreground="{StaticResource Dim}" FontSize="13" Margin="0,3,0,0" x:Name="SignedInText"/>
            </StackPanel>

            <!-- only on the owner's PC: the reports, with how many are open -->
            <Button Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" x:Name="FlagButton">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Height="36" Width="36">
                            <Border Background="#3A1E1E" CornerRadius="9"/>
                            <TextBlock FontFamily="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="17" Foreground="#FF4D4D" HorizontalAlignment="Center" Text="&#xE7C1;" VerticalAlignment="Center"/>
                            <ContentPresenter/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <Border Background="#FF4D4D" CornerRadius="9" Height="18" HorizontalAlignment="Right" Margin="0,-6,-6,0" MinWidth="18" Padding="4,0" VerticalAlignment="Top" Visibility="Collapsed" x:Name="FlagBadge">
                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="FlagCount"/>
                </Border>
            </Button>

            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn}" x:Name="FilterButton">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="13" Margin="0,0,7,0" Text="&#xE71C;" VerticalAlignment="Center" x:Name="FilterIcon"/>
                            <TextBlock VerticalAlignment="Center" x:Name="FilterText"/>
                            <Border Background="#E4572E" CornerRadius="9" Margin="7,0,0,0" MinWidth="18" Padding="4,0" Visibility="Collapsed" x:Name="FilterCount">
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" x:Name="FilterCountText"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Background="#E4572E" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,0" Style="{StaticResource Btn}" x:Name="PublishPageButton"/>
                </StackPanel>
                <Grid Grid.Column="1">
                    <TextBox CharacterCasing="Upper" MaxLength="40" Style="{StaticResource Field}" x:Name="CodeBox"/>
                    <TextBlock Foreground="{StaticResource Dim}" IsHitTestVisible="False" Margin="14,0,0,0" VerticalAlignment="Center" x:Name="CodeHint"/>
                </Grid>
                <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource Btn}" x:Name="OpenCodeButton"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#2A2A2A" CornerRadius="10" Margin="0,0,14,14" Padding="13" Visibility="Collapsed" x:Name="FilterPanel">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Width="210" x:Name="SortList"/>
                                    <StackPanel Width="210" x:Name="ShowList"/>
                                </StackPanel>
                                <StackPanel Margin="0,8,0,0" x:Name="ColorColumn"/>
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="2" Rows="3" VerticalAlignment="Top" x:Name="Cards"/>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock FontSize="17" Foreground="#777777" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" x:Name="EmptyText"/>

                <!-- report: why, and an optional note -->
                <Border Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Center" Padding="18" Panel.ZIndex="6" VerticalAlignment="Center" Visibility="Collapsed" Width="460" x:Name="ReportPanel">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" x:Name="ReportTitle"/>
                        <StackPanel Margin="0,10,0,0" x:Name="ReasonList"/>
                        <TextBox AcceptsReturn="False" Margin="0,10,0,0" MaxLength="300" Style="{StaticResource Field}" x:Name="ReportNote"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource Dim}" Margin="0,5,0,0" TextWrapping="Wrap" x:Name="ReportNoteHint"/>
                        <StackPanel HorizontalAlignment="Right" Margin="0,12,0,0" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Style="{StaticResource Btn}" x:Name="ReportCancel"/>
                            <Button Background="#E4572E" FontWeight="SemiBold" Foreground="White" IsEnabled="False" Style="{StaticResource Btn}" x:Name="ReportSend"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3">
                <TextBlock Foreground="{StaticResource Dim}" HorizontalAlignment="Left" MaxWidth="420" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" x:Name="MessageText"/>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center" x:Name="Pager"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource Btn}" VerticalAlignment="Center" Visibility="Collapsed" x:Name="ShowAllButton"/>
                <Border Background="#E4572E" CornerRadius="19" HorizontalAlignment="Center" Padding="16,9" VerticalAlignment="Center" Visibility="Collapsed" x:Name="Toast">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="13" Foreground="White" Margin="0,0,8,0" Text="&#xE73E;" VerticalAlignment="Center" x:Name="ToastIcon"/>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" x:Name="ToastText"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
