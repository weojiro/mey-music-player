<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>TaskbarPlayerProto</RootNamespace>
    <AssemblyName>MMP</AssemblyName>
    <AssemblyTitle>mey music player</AssemblyTitle>
    <Product>mey music player</Product>
    <!-- the release workflow overrides this with the release tag (v0.2.0 -> 0.2.0) -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its names out of the WPF code -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- tray icon only; the exe and its windows use app.ico (ApplicationIcon) -->
    <EmbeddedResource Include="tray.ico" LogicalName="tray.ico" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
