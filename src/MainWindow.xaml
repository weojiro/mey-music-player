<Window x:Class="TaskbarPlayerProto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mey music player"
        Height="40" Width="382"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Content" Width="382" Height="40">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="Scale"/>
        </Grid.LayoutTransform>

        <!-- Açılan Oynatıcı Paneli (Net 338px genişlik) -->
        <Border x:Name="PlayerPanel" CornerRadius="8" ClipToBounds="True" Background="#2B2B2B" Height="40" Width="338" HorizontalAlignment="Left" Margin="44,0,0,0">
            <Grid Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Medya Kontrolleri -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <Button x:Name="BtnMix" Style="{StaticResource TextButton}" Content="&#xE8B1;" Width="28" Height="28"/>
                    <Button x:Name="BtnPrev" Style="{StaticResource TextButton}" Content="&#xE892;" Width="28" Height="28" Margin="4,0,0,0"/>
                    <Button x:Name="BtnPlay" Style="{StaticResource TextButton}" Content="&#xE768;" Width="32" Height="32" FontSize="16" Margin="4,0,0,0"/>
                    <Button x:Name="BtnNext" Style="{StaticResource TextButton}" Content="&#xE893;" Width="28" Height="28" Margin="4,0,0,0"/>
                    <Button x:Name="BtnLoop" Style="{StaticResource TextButton}" Content="&#xE8EE;" Width="28" Height="28" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- İlerleme Çubuğu & Süre -->
                <Grid Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TimeText" Text="0:00" FontSize="11" Foreground="#CCFFFFFF" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                    <Grid x:Name="SeekHit" Grid.Row="1" Height="14" Background="Transparent" Cursor="Hand">
                        <Border x:Name="SeekTrack" Height="4" Background="#44FFFFFF" CornerRadius="2" VerticalAlignment="Center"/>
                        <Border x:Name="SeekFill" Height="4" Background="White" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Ellipse x:Name="SeekThumb" Width="10" Height="10" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- Ses Kontrolü -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid x:Name="VolumeHit" Background="Transparent" Cursor="Hand" Width="28" Height="28">
                        <TextBlock x:Name="VolumeGlyph" Text="&#xE995;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Albüm Kapağı Butonu -->
        <Border x:Name="Cover" CornerRadius="8" ClipToBounds="True" Width="40" Height="40" Background="#333333" Cursor="Hand" HorizontalAlignment="Left">
            <TextBlock x:Name="Glyph" Text="&#xE93C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
