<Window x:Class="TaskbarPlayerProto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mey music player"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="-10000" Top="-10000"
        Width="40" Height="40">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#FF3A3A3A" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Designed at 40 units tall; scaled in code to the taskbar height. -->
    <Grid x:Name="Root" ClipToBounds="True" Background="Transparent" UseLayoutRounding="True">
        <Grid x:Name="Content" Width="382" Height="40"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <Border x:Name="Cover" Width="40" Height="40" HorizontalAlignment="Left"
                    CornerRadius="6" Background="#FF2B2B2B" Cursor="Hand">
                <TextBlock x:Name="Glyph" Text="♫" Foreground="White" FontSize="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Border x:Name="PlayerPanel" Margin="44,0,0,0" Width="338" HorizontalAlignment="Left"
                    CornerRadius="6" Background="#FF2B2B2B">
                <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                    <Button x:Name="BtnPrev" Style="{StaticResource IconButton}"
                            Width="28" Height="28" FontSize="14" Content="&#xE892;" />
                    <Button x:Name="BtnPlay" Style="{StaticResource IconButton}"
                            Width="28" Height="28" FontSize="16" Content="&#xE768;" />
                    <Button x:Name="BtnNext" Style="{StaticResource IconButton}"
                            Width="28" Height="28" FontSize="14" Content="&#xE893;" />

                    <TextBlock x:Name="TimeText" Text="0:00" Foreground="#CCFFFFFF" FontSize="11"
                               Width="30" TextAlignment="Left" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                    <Grid x:Name="SeekHit" Width="124" Height="24" Background="Transparent"
                          VerticalAlignment="Center" Cursor="Hand" Margin="8,0,0,0">
                        <Border x:Name="SeekTrack" Height="3" CornerRadius="1.5" Background="#44FFFFFF"
                                VerticalAlignment="Center" />
                        <Border x:Name="SeekFill" Height="3" CornerRadius="1.5" Background="#FF3A96DD"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" />
                        <Ellipse x:Name="SeekThumb" Width="10" Height="10" Fill="White"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Visibility="Collapsed" />
                    </Grid>

                    <Grid x:Name="VolumeHit" Width="28" Height="28" Margin="8,0,0,0" Cursor="Hand"
                          Background="Transparent" VerticalAlignment="Center">
                        <TextBlock x:Name="VolumeGlyph" Text="&#xE995;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="BtnMix" Style="{StaticResource IconButton}"
                                Width="28" Height="19" FontSize="12" Content="&#xE8B1;" />
                        <Button x:Name="BtnLoop" Style="{StaticResource IconButton}"
                                Width="28" Height="19" FontSize="12" Content="&#xE8EE;" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
