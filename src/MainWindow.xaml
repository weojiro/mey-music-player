<Window x:Class="TaskbarPlayerProto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mey music player"
        Height="40" Width="382"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Content" Width="382" Height="40">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="Scale"/>
        </Grid.LayoutTransform>

        <!-- Orijinal Arayüz Dizilimi Paneli -->
        <Border x:Name="PlayerPanel" CornerRadius="8" ClipToBounds="True" Background="#2B2B2B" Height="40" Width="338" HorizontalAlignment="Left">
            <Grid Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- 1. Medya Kontrolleri -->
                    <ColumnDefinition Width="Auto"/> <!-- 2. Süre (0:10) -->
                    <ColumnDefinition Width="*"/>    <!-- 3. İlerleme Çubuğu -->
                    <ColumnDefinition Width="Auto"/> <!-- 4. Ses -->
                    <ColumnDefinition Width="Auto"/> <!-- 5. Dikey Karıştır / Döngü -->
                </Grid.ColumnDefinitions>

                <!-- 1. Medya Kontrolleri -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="BtnPrev" Style="{StaticResource TextButton}" Content="&#xE892;" Width="28" Height="32" FontSize="13"/>
                    <Button x:Name="BtnPlay" Style="{StaticResource TextButton}" Content="&#xE768;" Width="32" Height="32" FontSize="15" Margin="4,0,4,0"/>
                    <Button x:Name="BtnNext" Style="{StaticResource TextButton}" Content="&#xE893;" Width="28" Height="32" FontSize="13"/>
                </StackPanel>

                <!-- 2. Süre (0:10) -->
                <TextBlock x:Name="TimeText" Grid.Column="1" Text="0:00" FontSize="11" Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <!-- 3. İlerleme Çubuğu -->
                <Grid x:Name="SeekHit" Grid.Column="2" Height="16" Background="Transparent" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border x:Name="SeekTrack" Height="4" Background="#44FFFFFF" CornerRadius="2" VerticalAlignment="Center"/>
                    <Border x:Name="SeekFill" Height="4" Background="White" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Ellipse x:Name="SeekThumb" Width="10" Height="10" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>

                <!-- 4. Ses Kontrolü -->
                <Grid x:Name="VolumeHit" Grid.Column="3" Background="Transparent" Cursor="Hand" Width="28" Height="32" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="VolumeGlyph" Text="&#xE995;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- 5. Karıştır / Döngü -->
                <StackPanel Grid.Column="4" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button x:Name="BtnMix" Style="{StaticResource TextButton}" Content="&#xE8B1;" Width="18" Height="15" FontSize="10"/>
                    <Button x:Name="BtnLoop" Style="{StaticResource TextButton}" Content="&#xE8EE;" Width="18" Height="15" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Albüm Kapağı Butonu -->
        <Border x:Name="Cover" CornerRadius="8" ClipToBounds="True" Width="40" Height="40" Background="#333333" Cursor="Hand" HorizontalAlignment="Right">
            <TextBlock x:Name="Glyph" Text="&#xEC4F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- 1 Saniye Durunca Açılan Kapağa Ortalı Bukalemun Şarkı Adı Kartı -->
        <Popup x:Name="TitlePopup" PlacementTarget="{Binding ElementName=Cover}" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True">
            <Border x:Name="TitlePopupBorder" Background="#2B2B2B" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,8" MinWidth="110" MaxWidth="240" Margin="4">
                <TextBlock x:Name="TitlePopupText" Text="" FontFamily="Segoe UI Variable Text, Segoe UI" FontWeight="SemiBold" FontSize="12" Foreground="White" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" TextAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Popup>
    </Grid>
</Window>
