<Window x:Class="TaskbarPlayerProto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mey music player"
        Height="40" Width="382"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="Button" x:Key="TextButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Height="40" Width="382" x:Name="Content">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="Scale"/>
        </Grid.LayoutTransform>

        <!-- Player panel -->
        <Border Background="#2B2B2B" ClipToBounds="True" CornerRadius="8" Height="40" HorizontalAlignment="Left" Width="338" x:Name="PlayerPanel">
            <Grid>
            <Grid Margin="10,0,10,0" x:Name="ControlsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- 1. Media controls -->
                    <ColumnDefinition Width="Auto"/> <!-- 2. Time (0:10) -->
                    <ColumnDefinition Width="*"/>    <!-- 3. Seek bar -->
                    <ColumnDefinition Width="Auto"/> <!-- 4. Volume -->
                    <ColumnDefinition Width="Auto"/> <!-- 5. Shuffle / repeat, stacked -->
                </Grid.ColumnDefinitions>

                <!-- 1. Media controls -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#xE892;" FontSize="13" Height="32" Style="{StaticResource TextButton}" Width="28" x:Name="BtnPrev"/>
                    <Button Content="&#xE768;" FontSize="15" Height="32" Margin="4,0,4,0" Style="{StaticResource TextButton}" Width="32" x:Name="BtnPlay"/>
                    <Button Content="&#xE893;" FontSize="13" Height="32" Style="{StaticResource TextButton}" Width="28" x:Name="BtnNext"/>
                </StackPanel>

                <!-- 2. Time (0:10) -->
                <TextBlock FontSize="11" Foreground="#CCFFFFFF" Grid.Column="1" Margin="0,0,8,0" Text="0:00" VerticalAlignment="Center" x:Name="TimeText"/>

                <!-- 3. Seek bar -->
                <Grid Background="Transparent" Cursor="Hand" Grid.Column="2" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" x:Name="SeekHit">
                    <Border Background="#44FFFFFF" CornerRadius="2" Height="4" VerticalAlignment="Center" x:Name="SeekTrack"/>
                    <Border Background="White" CornerRadius="2" Height="4" HorizontalAlignment="Left" VerticalAlignment="Center" x:Name="SeekFill"/>
                    <Ellipse Fill="White" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center" Width="10" x:Name="SeekThumb"/>
                </Grid>

                <!-- 4. Volume -->
                <Grid Background="Transparent" Cursor="Hand" Grid.Column="3" Height="32" Margin="0,0,8,0" VerticalAlignment="Center" Width="28" x:Name="VolumeHit">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="White" HorizontalAlignment="Center" Text="&#xE995;" VerticalAlignment="Center" x:Name="VolumeGlyph"/>
                </Grid>

                <!-- 5. Shuffle / repeat -->
                <StackPanel Grid.Column="4" HorizontalAlignment="Center" Orientation="Vertical" VerticalAlignment="Center">
                    <Button Content="&#xE8B1;" FontSize="10" Height="15" Style="{StaticResource TextButton}" Width="18" x:Name="BtnMix"/>
                    <Button Content="&#xE8EE;" FontSize="10" Height="15" Margin="0,2,0,0" Style="{StaticResource TextButton}" Width="18" x:Name="BtnLoop"/>
                </StackPanel>
            </Grid>

            <!-- Lyrics over the controls: the two lines take turns when the line changes (old one up and out, new one in from below) -->
            <Grid ClipToBounds="True" IsHitTestVisible="False" Margin="12,0,12,0" Opacity="0" Visibility="Collapsed" x:Name="LyricsLayer">
                <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="White" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" x:Name="LyricA">
                    <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="15" FontWeight="Bold" Foreground="White" Opacity="0" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" x:Name="LyricB">
                    <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
            </Grid>
        </Border>

        <!-- Cover -->
        <Border Background="#333333" ClipToBounds="True" CornerRadius="8" Cursor="Hand" Height="40" HorizontalAlignment="Right" Width="40" x:Name="Cover">
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" Text="&#xEC4F;" VerticalAlignment="Center" x:Name="Glyph"/>
        </Border>

        <!-- Title card: the song name, centered on the cover after the mouse rests on it for 1 s -->
        <Popup AllowsTransparency="True" PlacementTarget="{Binding ElementName=Cover}" PopupAnimation="Fade" StaysOpen="True" x:Name="TitlePopup">
            <Border Background="#2B2B2B" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" MaxWidth="240" MinWidth="110" Padding="12,8" x:Name="TitlePopupBorder">
                <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="White" MaxHeight="36" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" VerticalAlignment="Center" x:Name="TitlePopupText"/>
            </Border>
        </Popup>
    </Grid>
</Window>
