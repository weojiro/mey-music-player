<Window x:Class="TaskbarPlayerProto.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1F1F1F"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="#E3E3E3"
        ResizeMode="CanMinimize"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <!-- Same palette as the tray menu: #1F1F1F, #E3E3E3 text, #9AA0A6 dim text; cards #262626, rounded corners -->
    <Window.Resources>
        <SolidColorBrush x:Key="Dim" Color="#9AA0A6"/>
        <SolidColorBrush x:Key="Card" Color="#262626"/>
        <SolidColorBrush x:Key="Line" Color="#333333"/>

        <Style TargetType="Button" x:Key="Btn">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#E3E3E3"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" x:Name="Box">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="Box" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" TargetName="Box" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- pill for player chips and the zoom switch; the selected one is drawn inverted from code -->
        <Style BasedOn="{StaticResource Btn}" TargetType="Button" x:Key="Chip">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}" x:Name="Box">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="Box" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="Field">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="Foreground" Value="#E3E3E3"/>
            <Setter Property="CaretBrush" Value="#E3E3E3"/>
            <Setter Property="SelectionBrush" Value="#5E5E5E"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="8" x:Name="Box">
                            <ScrollViewer Margin="{TemplateBinding Padding}" VerticalAlignment="Center" x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="Box" Value="#7A7A7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="Section">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel Margin="28,22,28,24" MinWidth="640" x:Name="Page">

            <Grid>
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold" x:Name="TitleText"/>
                    <TextBlock Foreground="{StaticResource Dim}" Margin="0,4,0,0" x:Name="AutoSaveText"/>
                </StackPanel>
                <Border Background="{StaticResource Card}" CornerRadius="17" HorizontalAlignment="Right" Padding="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" x:Name="ZoomButtons"/>
                </Border>
            </Grid>

            <TextBlock Margin="0,20,0,8" Style="{StaticResource Section}" x:Name="PlayersText"/>
            <WrapPanel x:Name="PlayerChips"/>

            <!-- the preview: the real player's layout at 1x / 2x / 3x; pictures can be dragged, resized and rotated here -->
            <Border Background="{StaticResource Card}" CornerRadius="12" Margin="0,14,0,0" Padding="24,28">
                <Grid FlowDirection="LeftToRight" HorizontalAlignment="Center" x:Name="PreviewHost">
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="3" ScaleY="3" x:Name="PreviewScale"/>
                    </Grid.LayoutTransform>
                    <Grid Height="40" Width="382">
                        <Border CornerRadius="8" Height="40" HorizontalAlignment="Left" Width="338" x:Name="PvPanel">
                            <Grid>
                                <Canvas Background="Transparent" x:Name="PvStickers">
                                    <Canvas.Clip><RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,338,40"/></Canvas.Clip>
                                </Canvas>
                                <Grid IsHitTestVisible="False" Margin="10,0,10,0" x:Name="PvControls">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" Text="&#xE892;" TextAlignment="Center" VerticalAlignment="Center" Width="28" x:Name="PvPrev"/>
                                        <TextBlock FontSize="15" Margin="4,0,4,0" Text="&#xE769;" TextAlignment="Center" VerticalAlignment="Center" Width="32" x:Name="PvPlay"/>
                                        <TextBlock FontSize="13" Text="&#xE893;" TextAlignment="Center" VerticalAlignment="Center" Width="28" x:Name="PvNext"/>
                                    </StackPanel>
                                    <TextBlock FontFamily="Segoe UI" FontSize="11" Grid.Column="1" Margin="0,0,8,0" Text="1:23" VerticalAlignment="Center" x:Name="PvTime"/>
                                    <Grid Grid.Column="2" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Border CornerRadius="2" Height="4" VerticalAlignment="Center" x:Name="PvTrack"/>
                                        <Border CornerRadius="2" Height="4" HorizontalAlignment="Left" VerticalAlignment="Center" Width="62" x:Name="PvFill"/>
                                        <Ellipse Height="10" HorizontalAlignment="Left" Margin="57,0,0,0" VerticalAlignment="Center" Width="10" x:Name="PvThumb"/>
                                    </Grid>
                                    <TextBlock FontSize="13" Grid.Column="3" Margin="0,0,8,0" Text="&#xE994;" TextAlignment="Center" VerticalAlignment="Center" Width="28" x:Name="PvVolume"/>
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <TextBlock FontSize="10" Height="15" Text="&#xE8B1;" TextAlignment="Center" Width="18" x:Name="PvMix"/>
                                        <TextBlock FontSize="10" Height="15" Margin="0,2,0,0" Text="&#xE8EE;" TextAlignment="Center" Width="18" x:Name="PvLoop"/>
                                    </StackPanel>
                                </Grid>
                                <Canvas x:Name="PvOverlay"/>
                            </Grid>
                        </Border>
                        <Border ClipToBounds="True" CornerRadius="8" Height="40" HorizontalAlignment="Right" Width="40" x:Name="PvCover">
                            <TextBlock FontSize="18" Foreground="White" HorizontalAlignment="Center" Text="&#xEC4F;" VerticalAlignment="Center" x:Name="PvGlyph"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <TextBlock FontSize="12" Foreground="{StaticResource Dim}" Margin="2,8,0,0" TextWrapping="Wrap" x:Name="HintText"/>

            <!-- name of the player being edited -->
            <Grid Margin="0,18,0,0" x:Name="NameRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0" x:Name="NameText"/>
                <TextBox Grid.Column="1" MaxLength="32" MaxWidth="320" HorizontalAlignment="Left" MinWidth="240" Style="{StaticResource Field}" x:Name="NameBox"/>
                <Button Foreground="#F28B82" Grid.Column="2" Style="{StaticResource Btn}" x:Name="DeletePlayerButton"/>
            </Grid>

            <Border Background="{StaticResource Line}" Height="1" Margin="0,18"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Margin="0" Style="{StaticResource Section}" VerticalAlignment="Center" x:Name="BgText"/>
                <WrapPanel Grid.Column="1" x:Name="BgSwatches"/>
                <TextBlock Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource Section}" VerticalAlignment="Center" x:Name="ButtonsText"/>
                <WrapPanel Grid.Column="1" Grid.Row="1" Margin="0,12,0,0" x:Name="ButtonSwatches"/>
            </Grid>

            <Border Background="{StaticResource Line}" Height="1" Margin="0,18"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0" Style="{StaticResource Section}" VerticalAlignment="Top" Padding="0,8,0,0" x:Name="ImagesText"/>
                <StackPanel Grid.Column="1">
                    <WrapPanel>
                        <Button Background="#E3E3E3" Foreground="#1F1F1F" Margin="0,0,8,0" Style="{StaticResource Btn}" x:Name="AddImageButton"/>
                        <Button Margin="0,0,8,0" Style="{StaticResource Btn}" x:Name="FrontButton"/>
                        <Button Margin="0,0,8,0" Style="{StaticResource Btn}" x:Name="BackButton"/>
                        <Button Foreground="#F28B82" Style="{StaticResource Btn}" x:Name="RemoveButton"/>
                    </WrapPanel>
                    <TextBlock FontSize="12" Foreground="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap" x:Name="ImageHintText"/>
                    <TextBlock FontSize="12" Foreground="#F28B82" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" x:Name="MessageText"/>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource Line}" Height="1" Margin="0,18"/>

            <Button Foreground="#F28B82" HorizontalAlignment="Left" Style="{StaticResource Btn}" x:Name="ResetButton"/>
        </StackPanel>

        <!-- confirmation over the page (reset, delete player) -->
        <Border Background="#B0101010" Visibility="Collapsed" x:Name="ConfirmLayer">
            <Border Background="{StaticResource Card}" CornerRadius="12" HorizontalAlignment="Center" MaxWidth="420" Padding="22,20" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock FontSize="14" TextWrapping="Wrap" x:Name="ConfirmText"/>
                    <StackPanel HorizontalAlignment="Right" Margin="0,18,0,0" Orientation="Horizontal">
                        <Button Margin="0,0,8,0" Style="{StaticResource Btn}" x:Name="ConfirmCancel"/>
                        <Button Background="#F28B82" Foreground="#1F1F1F" Style="{StaticResource Btn}" x:Name="ConfirmYes"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
