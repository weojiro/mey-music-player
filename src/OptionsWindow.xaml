<Window x:Class="TaskbarPlayerProto.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1F1F1F"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="#E3E3E3"
        ResizeMode="CanMinimize"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <!-- styles: Theme.xaml -->
    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </Window.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" x:Name="PageScroll">
        <StackPanel Margin="28,22,28,24" MinWidth="640" x:Name="Page">

            <Grid>
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold" x:Name="TitleText"/>
                    <TextBlock Foreground="{StaticResource Dim}" Margin="0,4,0,0" x:Name="AutoSaveText"/>
                </StackPanel>
                <Border Background="{StaticResource Card}" CornerRadius="17" HorizontalAlignment="Right" Padding="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" x:Name="ZoomButtons"/>
                </Border>
            </Grid>

            <TextBlock Margin="0,20,0,8" Style="{StaticResource Section}" x:Name="PlayersText"/>
            <WrapPanel x:Name="PlayerChips"/>

            <!-- the preview: the real player's layout at 1x / 2x / 3x; pictures can be dragged, resized and rotated here.
                 Above the rows below it, so the handles of a big picture get the clicks, not the swatches under them. -->
            <Border Background="{StaticResource Card}" CornerRadius="12" Margin="0,14,0,0" Padding="24,28" Panel.ZIndex="1">
                <Grid FlowDirection="LeftToRight" HorizontalAlignment="Center" x:Name="PreviewHost">
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="3" ScaleY="3" x:Name="PreviewScale"/>
                    </Grid.LayoutTransform>
                    <Grid Height="40" Width="382">
                        <Border CornerRadius="8" Height="40" HorizontalAlignment="Left" Width="338" x:Name="PvPanel">
                            <Grid>
                                <Canvas Background="Transparent" x:Name="PvStickers">
                                    <Canvas.Clip><RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,338,40"/></Canvas.Clip>
                                </Canvas>
                                <Grid IsHitTestVisible="False" Margin="10,0,10,0" x:Name="PvControls">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" Text="&#xE892;" TextAlignment="Center" VerticalAlignment="Center" Width="28" x:Name="PvPrev"/>
                                        <TextBlock FontSize="15" Margin="4,0,4,0" Text="&#xE769;" TextAlignment="Center" VerticalAlignment="Center" Width="32" x:Name="PvPlay"/>
                                        <TextBlock FontSize="13" Text="&#xE893;" TextAlignment="Center" VerticalAlignment="Center" Width="28" x:Name="PvNext"/>
                                    </StackPanel>
                                    <TextBlock FontFamily="Segoe UI" FontSize="11" Grid.Column="1" Margin="0,0,8,0" Text="1:23" VerticalAlignment="Center" x:Name="PvTime"/>
                                    <Grid Grid.Column="2" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Border CornerRadius="2" Height="4" VerticalAlignment="Center" x:Name="PvTrack"/>
                                        <Border CornerRadius="2" Height="4" HorizontalAlignment="Left" VerticalAlignment="Center" Width="62" x:Name="PvFill"/>
                                        <Ellipse Height="10" HorizontalAlignment="Left" Margin="57,0,0,0" VerticalAlignment="Center" Width="10" x:Name="PvThumb"/>
                                    </Grid>
                                    <TextBlock FontSize="13" Grid.Column="3" Margin="0,0,8,0" Text="&#xE994;" TextAlignment="Center" VerticalAlignment="Center" Width="28" x:Name="PvVolume"/>
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <TextBlock FontSize="10" Height="15" Text="&#xE8B1;" TextAlignment="Center" Width="18" x:Name="PvMix"/>
                                        <TextBlock FontSize="10" Height="15" Margin="0,2,0,0" Text="&#xE8EE;" TextAlignment="Center" Width="18" x:Name="PvLoop"/>
                                    </StackPanel>
                                </Grid>
                                <Canvas x:Name="PvOverlay"/>
                            </Grid>
                        </Border>
                        <Border ClipToBounds="True" CornerRadius="8" Height="40" HorizontalAlignment="Right" Width="40" x:Name="PvCover">
                            <TextBlock FontSize="18" Foreground="White" HorizontalAlignment="Center" Text="&#xEC4F;" VerticalAlignment="Center" x:Name="PvGlyph"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <TextBlock FontSize="12" Foreground="{StaticResource Dim}" Margin="2,8,0,0" TextWrapping="Wrap" x:Name="HintText"/>

            <!-- name of the player being edited -->
            <Grid Margin="0,18,0,0" x:Name="NameRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0" x:Name="NameText"/>
                <TextBox Grid.Column="1" MaxLength="32" MaxWidth="320" HorizontalAlignment="Left" MinWidth="240" Style="{StaticResource Field}" x:Name="NameBox"/>
                <Button Foreground="#F28B82" Grid.Column="2" Style="{StaticResource Btn}" x:Name="DeletePlayerButton"/>
            </Grid>

            <Border Background="{StaticResource Line}" Height="1" Margin="0,18"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Margin="0" Style="{StaticResource Section}" VerticalAlignment="Center" x:Name="BgText"/>
                <WrapPanel Grid.Column="1" x:Name="BgSwatches"/>
                <TextBlock Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource Section}" VerticalAlignment="Center" x:Name="ButtonsText"/>
                <WrapPanel Grid.Column="1" Grid.Row="1" Margin="0,12,0,0" x:Name="ButtonSwatches"/>

                <!-- transparency: one slider for all, or one each for the background, the buttons and the cover -->
                <TextBlock Grid.Row="2" Margin="0,16,0,0" Padding="0,2,0,0" Style="{StaticResource Section}" VerticalAlignment="Top" x:Name="ClearText"/>
                <StackPanel Grid.Column="1" Grid.Row="2" Margin="0,16,0,0">
                    <CheckBox Style="{StaticResource Switch}" x:Name="ClearAllBox"/>
                    <Grid Margin="0,10,0,0" x:Name="ClearSliders">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Slider Grid.Column="1" Style="{StaticResource Range}" x:Name="ClearAllSlider"/>
                        <TextBlock Grid.Column="2" Margin="10,0,0,0" MinWidth="36" VerticalAlignment="Center" x:Name="ClearAllValue"/>
                        <TextBlock Grid.Row="1" Foreground="{StaticResource Dim}" Margin="0,0,12,0" VerticalAlignment="Center" x:Name="ClearBgLabel"/>
                        <Slider Grid.Column="1" Grid.Row="1" Style="{StaticResource Range}" x:Name="ClearBgSlider"/>
                        <TextBlock Grid.Column="2" Grid.Row="1" Margin="10,0,0,0" MinWidth="36" VerticalAlignment="Center" x:Name="ClearBgValue"/>
                        <TextBlock Grid.Row="2" Foreground="{StaticResource Dim}" Margin="0,0,12,0" VerticalAlignment="Center" x:Name="ClearButtonsLabel"/>
                        <Slider Grid.Column="1" Grid.Row="2" Style="{StaticResource Range}" x:Name="ClearButtonsSlider"/>
                        <TextBlock Grid.Column="2" Grid.Row="2" Margin="10,0,0,0" MinWidth="36" VerticalAlignment="Center" x:Name="ClearButtonsValue"/>
                        <TextBlock Grid.Row="3" Foreground="{StaticResource Dim}" Margin="0,0,12,0" VerticalAlignment="Center" x:Name="ClearCoverLabel"/>
                        <Slider Grid.Column="1" Grid.Row="3" Style="{StaticResource Range}" x:Name="ClearCoverSlider"/>
                        <TextBlock Grid.Column="2" Grid.Row="3" Margin="10,0,0,0" MinWidth="36" VerticalAlignment="Center" x:Name="ClearCoverValue"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource Line}" Height="1" Margin="0,18"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0" Style="{StaticResource Section}" VerticalAlignment="Top" Padding="0,8,0,0" x:Name="ImagesText"/>
                <StackPanel Grid.Column="1">
                    <WrapPanel>
                        <Button Background="#E3E3E3" Foreground="#1F1F1F" Margin="0,0,8,0" Style="{StaticResource Btn}" x:Name="AddImageButton"/>
                        <Button Foreground="#F28B82" Style="{StaticResource Btn}" x:Name="RemoveButton"/>
                    </WrapPanel>
                    <!-- layers: the top row is the image in front; rows are dragged to reorder -->
                    <Border Background="{StaticResource Card}" CornerRadius="10" HorizontalAlignment="Left" Margin="0,12,0,0" MinWidth="360" Padding="4" Visibility="Collapsed" x:Name="LayerCard">
                        <StackPanel Background="Transparent" x:Name="LayerList"/>
                    </Border>
                    <TextBlock FontSize="12" Foreground="{StaticResource Dim}" Margin="0,6,0,0" Visibility="Collapsed" x:Name="LayerHintText"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap" x:Name="ImageHintText"/>
                    <TextBlock FontSize="12" Foreground="#F28B82" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" x:Name="MessageText"/>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource Line}" Height="1" Margin="0,18"/>

            <Button Foreground="#F28B82" HorizontalAlignment="Left" Style="{StaticResource Btn}" x:Name="ResetButton"/>

            <Border Background="{StaticResource Line}" Height="1" Margin="0,18"/>

            <!-- where the player sits: free move, always on top, the show / hide shortcut; the player size on the right -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,8,0" Padding="0,2,0,0" Style="{StaticResource Section}" TextWrapping="Wrap" VerticalAlignment="Top" x:Name="PlacementText"/>
                <StackPanel Grid.Column="1" MaxWidth="480" HorizontalAlignment="Left">
                    <CheckBox Style="{StaticResource Switch}" x:Name="FreeMoveBox"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource Dim}" Margin="46,4,0,0" TextWrapping="Wrap" x:Name="FreeMoveHint"/>
                    <CheckBox Margin="0,16,0,0" Style="{StaticResource Switch}" x:Name="OnTopBox"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource Dim}" Margin="46,4,0,0" TextWrapping="Wrap" x:Name="OnTopHint"/>
                    <!-- the two shortcuts: click one, then press the new keys -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" x:Name="HotkeyText"/>
                        <Button Grid.Column="1" HorizontalAlignment="Left" MinWidth="150" Style="{StaticResource Btn}" x:Name="ShowKeyButton"/>
                        <TextBlock Grid.Row="1" Margin="0,8,12,0" VerticalAlignment="Center" x:Name="CursorKeyText"/>
                        <Button Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" Margin="0,8,0,0" MinWidth="150" Style="{StaticResource Btn}" x:Name="CursorKeyButton"/>
                    </Grid>
                    <!-- shown while "show over games" is off: the mouse shortcut only works with it -->
                    <TextBlock FontSize="12" Foreground="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" x:Name="CursorKeyNote"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap" x:Name="HotkeyHint"/>
                    <TextBlock FontSize="12" Foreground="#F28B82" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" x:Name="HotkeyMessage"/>
                </StackPanel>

                <!-- player size (free move only): slider or a typed %, and back to 100 % -->
                <Grid Grid.Column="2" Margin="48,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,8,0" Padding="0,8,0,0" Style="{StaticResource Section}" TextWrapping="Wrap" VerticalAlignment="Top" x:Name="SizeText"/>
                    <StackPanel Grid.Column="1" MaxWidth="320">
                        <StackPanel x:Name="SizeControls">
                            <StackPanel Orientation="Horizontal">
                                <Slider Style="{StaticResource Range}" VerticalAlignment="Center" Width="220" x:Name="SizeSlider"/>
                                <TextBox Margin="12,0,0,0" MaxLength="3" Style="{StaticResource Field}" TextAlignment="Center" VerticalAlignment="Center" Width="56" x:Name="SizeBox"/>
                                <TextBlock Margin="6,0,0,0" Text="%" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource Btn}" x:Name="SizeResetButton"/>
                        </StackPanel>
                        <!-- shown while free move is off: the size only works with it -->
                        <TextBlock FontSize="12" Foreground="{StaticResource Dim}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" x:Name="SizeNote"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </StackPanel>
        </ScrollViewer>

        <!-- confirmation over the page (reset, delete player) -->
        <Border Background="#B0101010" Visibility="Collapsed" x:Name="ConfirmLayer">
            <Border Background="{StaticResource Card}" CornerRadius="12" HorizontalAlignment="Center" MaxWidth="420" Padding="22,20" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock FontSize="14" TextWrapping="Wrap" x:Name="ConfirmText"/>
                    <StackPanel HorizontalAlignment="Right" Margin="0,18,0,0" Orientation="Horizontal">
                        <Button Margin="0,0,8,0" Style="{StaticResource Btn}" x:Name="ConfirmCancel"/>
                        <Button Background="#F28B82" Foreground="#1F1F1F" Style="{StaticResource Btn}" x:Name="ConfirmYes"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
