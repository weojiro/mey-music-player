<Window x:Class="TaskbarPlayerProto.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1F1F1F"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="#FFFFFF"
        Height="640"
        ResizeMode="CanMinimize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Width="1280"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </Window.Resources>

    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="20" FontWeight="SemiBold" x:Name="TitleText"/>
            <TextBlock Foreground="{StaticResource Dim}" Margin="0,3,0,0" x:Name="SubText"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,14,0,0" Orientation="Horizontal">
            <Button Margin="0,0,8,0" Style="{StaticResource Chip}" x:Name="PlayersChip"/>
            <Button Style="{StaticResource Chip}" x:Name="SoundsChip"/>
        </StackPanel>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="List"/>
        </ScrollViewer>
        <TextBlock Foreground="#FF9A9A" Grid.Row="3" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" x:Name="MessageText"/>
    </Grid>
</Window>
