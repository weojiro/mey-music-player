<Window x:Class="TaskbarPlayerProto.StreamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskbarPlayerProto"
        Background="#101010"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Height="661"
        MinHeight="300"
        MinWidth="480"
        Title="MMP"
        UseLayoutRounding="True"
        Width="1120"
        WindowStartupLocation="CenterScreen">

    <!-- styles: Theme.xaml (the mode chips look like the Options ones) -->
    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </Window.Resources>

    <!-- a window to share on Discord: the cover blurred behind, the song, and bars or a wave that move with the sound -->
    <Grid ClipToBounds="True" FlowDirection="LeftToRight">
        <!-- a tiny copy of the cover stretched smooth: looks blurred and costs nothing (a blur effect would be worked
             out again on every frame the bars move) -->
        <Image RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" x:Name="Backdrop"/>
        <Rectangle Fill="#A8101010"/>

        <!-- everything is laid out on a 1280x720 stage and scaled with the window: big and sharp on a stream, the
             same picture at any size -->
        <Viewbox Stretch="Uniform">
            <Grid Height="720" Width="1280">
                <local:Visualizer Height="400" VerticalAlignment="Bottom" x:Name="Viz"/>

                <Grid Margin="64,60,64,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#2A2A2A" BorderBrush="#30FFFFFF" BorderThickness="1.5" CornerRadius="18" Height="270" Width="270" x:Name="CoverBox"/>
                    <StackPanel Grid.Column="1" Margin="44,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="48" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" x:Name="SongText"/>
                        <TextBlock FontSize="28" Foreground="#D8D8D8" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" x:Name="ArtistText"/>
                        <Grid HorizontalAlignment="Left" Margin="0,40,0,0" Width="620">
                            <Border Background="#40FFFFFF" CornerRadius="4" Height="7" x:Name="Track"/>
                            <Border Background="White" CornerRadius="4" Height="7" HorizontalAlignment="Left" Width="0" x:Name="Progress"/>
                        </Grid>
                        <TextBlock FontSize="21" Foreground="#C8C8C8" Margin="0,14,0,0" x:Name="TimeText"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- only while the mouse is over the window: the people watching don't see them -->
        <StackPanel HorizontalAlignment="Right" Margin="0,0,14,12" Opacity="0" Orientation="Horizontal" VerticalAlignment="Bottom" x:Name="Modes">
            <Button Style="{StaticResource Chip}" Margin="0,0,6,0" x:Name="BarsButton"/>
            <Button Style="{StaticResource Chip}" x:Name="WaveButton"/>
        </StackPanel>

        <TextBlock FontSize="12" Foreground="#F28B82" HorizontalAlignment="Left" Margin="16,0,0,14" TextWrapping="Wrap" MaxWidth="420" VerticalAlignment="Bottom" Visibility="Collapsed" x:Name="NeedCable"/>
    </Grid>
</Window>
