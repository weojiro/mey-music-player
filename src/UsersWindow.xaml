<Window x:Class="TaskbarPlayerProto.UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#1F1F1F"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        Foreground="#FFFFFF"
        Height="640"
        ResizeMode="CanMinimize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Width="520"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </Window.Resources>

    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="20" FontWeight="SemiBold" x:Name="TitleText"/>
            <TextBlock Foreground="{StaticResource Dim}" Margin="0,3,0,0" x:Name="SubText"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="List"/>
        </ScrollViewer>
    </Grid>
</Window>
